<!DOCTYPE html>
<html>
  <head>
    <%# --- TITLE --- %>
    <title><%= content_for?(:title) ? yield(:title) : "L'Univers des Sens – Yoga & Randonnée Yoga en Ubaye" %></title>

    <%# --- META DESCRIPTION --- %>
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Cours de yoga (Vinyasa, Yin) et randonnées yoga à Barcelonnette et vallée de l’Ubaye. Séjours bien-être, nature et ressourcement avec Jennifer Camp." %>">

    <%# --- INDEXING --- %>
    <meta name="robots" content="index,follow">

    <%# --- VIEWPORT --- %>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">

    <%# --- CANONICAL (évite contenu dupliqué) --- %>
    <link rel="canonical" href="<%= request.original_url.split('?').first %>">

    <%# --- OpenGraph (Facebook / WhatsApp) --- %>
    <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : "Yoga & Randonnée Yoga à Barcelonnette | L’Univers des Sens" %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "Cours de yoga et randonnées yoga à Barcelonnette. Séjours bien-être en montagne avec Jennifer Camp." %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url.split('?').first %>">
    <%# Idéalement une image 1200x630 dans /app/assets/images/og.jpg %>
    <meta property="og:image" content="<%= image_url("og.jpg") rescue "" %>">

    <%# --- Twitter --- %>
    <meta name="twitter:card" content="summary_large_image">

    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <meta name="theme-color" content="#ffffff">
    <meta name="background-color" content="#ffffff">
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Flatpickr JS + localisation FR -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
  </head>


  <body>
    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>

    <%= yield %>

    <footer class="footer-section">
      <div class="footer-container">
        <div class="footer-logo">
          <%= link_to root_path, data: { turbo: false } do %>
            <%= image_tag "udslogo.png", alt: "Logo", class: "footer-logo-img" %>
          <% end %>
        </div>

        <nav class="footer-nav">
          <ul>
            <li><%= link_to "Accueil", root_path, data: { turbo: false } %></li>
            <li><%= link_to "Événements", root_path(anchor: 'evenements'), data: { turbo: false } %></li>
            <li><%= link_to "Politique de Confidentialité", privacy_policy_path %></li>
            <li><%= link_to "Mentions Légales", legal_mentions_path %></li>
            <li><%= link_to "Contact", root_path(anchor: 'contact'), data: { turbo: false } %></li>
          </ul>
        </nav>

        <div class="footer-social">
          <a href="https://www.facebook.com/randoubaye?locale=fr_FR" target="_blank"><i class="fab fa-facebook-f"></i></a>
          <a href="https://www.instagram.com/univers_des_sens/" target="_blank"><i class="fab fa-instagram"></i></a>
          <a href="https://www.youtube.com/@jennycamp04yoga/videos" target="_blank"><i class="fab fa-youtube"></i></a>
        </div>

        <hr class="footer-divider">
        <p class="footer-rights">&copy; <%= Time.now.year %> L'Univers des Sens - Tous droits réservés.</p>
      </div>
    </footer>

    <!-- JS Rails -->
    <%# <%= javascript_include_tag "application", "data-turbo-track": "reload" %>

    <!-- Animation logo -->
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const logo = document.querySelector(".logo");
        if (logo) {
          setTimeout(() => {
            logo.style.opacity = "1";
            logo.style.transform = "scale(1)";
          }, 500);
        }
      });
    </script>

    <!-- Navbar scroll effect -->
    <script>
      function handleNavbarScroll() {
        const navbar = document.querySelector(".navbar");
        if (!navbar) return;

        function onScroll() {
          if (window.scrollY > 50) {
            navbar.classList.add("scrolled");
          } else {
            navbar.classList.remove("scrolled");
          }
        }

        window.removeEventListener("scroll", onScroll);
        window.addEventListener("scroll", onScroll);
        onScroll();
      }

      document.addEventListener("turbo:load", handleNavbarScroll);
    </script>

    <!-- Scroll fluide vers les ancres -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const links = document.querySelectorAll('a[href^="/#"], a[href^="#"]');
        const navbarHeight = document.querySelector(".navbar")?.offsetHeight || 0;

        links.forEach(link => {
          link.addEventListener("click", function (e) {
            const hash = this.hash || this.href.split("#")[1];
            const target = document.getElementById(hash.replace("#", ""));

            if (target) {
              e.preventDefault();
              const top = target.getBoundingClientRect().top + window.scrollY - navbarHeight - 10;

              window.scrollTo({
                top: top,
                behavior: "smooth"
              });
            }
          });
        });
      });
    </script>

    <!-- Rechargement après retour arrière -->
    <script>
      window.addEventListener("pageshow", function (event) {
        if (event.persisted || window.performance.navigation.type === 2) {
          window.location.reload();
        }
      });
    </script>
  </body>
</html>
