<% content_for :title, "Randonnée guidée en montagne | L’Univers des Sens" %>
<% content_for :meta_description, "Randonnées guidées en montagne avec Jennifer, accompagnatrice en montagne. Sorties nature adaptées à votre niveau, en petit groupe ou en privé." %>

<section class="randonnee-hero">
  <%= image_tag "rando_carousel_6.jpg", class: "randonnee-hero-image", alt: "Vue panoramique en randonnée" %>
  <div class="randonnee-hero-overlay"></div>

  <div class="randonnee-hero-content">
    <span class="randonnee-chip">Randonnée guidée</span>
    <h1>RANDONNEE</h1>
    <p>
      Je vous accompagne en montagne pour vivre des randonnées guidées,
      pensées pour respirer, marcher et vous reconnecter à l'essentiel.
    </p>
    <%= link_to "Demander une sortie", root_path(anchor: "contact"), class: "btn", data: { turbo: false } %>
  </div>
</section>

<section class="randonnee-intro">
  <div class="randonnee-container">
    <div class="randonnee-text-card">
      <h2>Une expérience encadrée par une accompagnatrice en montagne</h2>
      <p>
        Je propose des randonnées guidées pour les particuliers, les familles,
        les groupes d'amis et les entreprises. J'adapte chaque itinéraire à votre
        niveau, au rythme du groupe et aux conditions du moment.
      </p>
      <p>
        Mon objectif: vous faire vivre une sortie en montagne en toute sérénité,
        profiter des paysages, apprendre à observer la nature et repartir avec
        une vraie sensation de bien-être.
      </p>
      <p>
        En demi-journée, en journée complète ou en format sur mesure,
        je conçois chaque sortie pour offrir un moment authentique, accessible et sécurisant.
      </p>
    </div>
  </div>
</section>

<section class="randonnee-gallery">
  <div class="randonnee-container">
    <h2>Ambiance nature</h2>
    <div class="randonnee-carousel" data-randonnee-carousel>
      <button class="randonnee-carousel-control prev" type="button" aria-label="Photo précédente" data-carousel-prev>
        &#10094;
      </button>

      <div class="randonnee-carousel-viewport">
        <div class="randonnee-carousel-track" data-carousel-track>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_1.jpg", alt: "Randonnée en altitude", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_2.jpg", alt: "Groupe au bord d'un lac de montagne", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_3.jpg", alt: "Sortie randonnée sur terrain volcanique", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_4.jpg", alt: "Bivouac en montagne au lever du jour", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_5.jpg", alt: "Papillon en pleine nature", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_6.jpg", alt: "Vue panoramique en randonnée", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_7.jpg", alt: "Marche en montagne sur sentier rouge", class: "randonnee-photo" %>
          </article>
          <article class="randonnee-photo-card">
            <%= image_tag "rando_carousel_8.jpg", alt: "Pause de groupe au sommet", class: "randonnee-photo" %>
          </article>
        </div>
      </div>

      <button class="randonnee-carousel-control next" type="button" aria-label="Photo suivante" data-carousel-next>
        &#10095;
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener("turbo:load", function () {
    document.querySelectorAll("[data-randonnee-carousel]").forEach(function (carousel) {
      if (carousel.dataset.ready === "true") return;
      carousel.dataset.ready = "true";

      var track = carousel.querySelector("[data-carousel-track]");
      var prevButton = carousel.querySelector("[data-carousel-prev]");
      var nextButton = carousel.querySelector("[data-carousel-next]");
      var index = 0;

      function perView() {
        if (window.innerWidth <= 700) return 1;
        if (window.innerWidth <= 900) return 2;
        return 3;
      }

      function maxIndex() {
        return Math.max(0, track.children.length - perView());
      }

      function update() {
        var gap = parseFloat(window.getComputedStyle(track).columnGap || window.getComputedStyle(track).gap || "0");
        var cardWidth = track.children[0].getBoundingClientRect().width;
        var offset = index * (cardWidth + gap);
        track.style.transform = "translateX(-" + offset + "px)";

        prevButton.disabled = index <= 0;
        nextButton.disabled = index >= maxIndex();
      }

      prevButton.addEventListener("click", function () {
        index = Math.max(0, index - 1);
        update();
      });

      nextButton.addEventListener("click", function () {
        index = Math.min(maxIndex(), index + 1);
        update();
      });

      window.addEventListener("resize", function () {
        index = Math.min(index, maxIndex());
        update();
      });

      update();
    });
  });
</script>
