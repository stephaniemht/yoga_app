<div class="banner">
  <%= image_tag "udslogo.png", alt: "Logo", class: "logo" %>
</div>

<div class="about-section">
  <div class="about-content row-layout">

    <!-- Colonne gauche : Carrousel -->
    <div class="carousel-container" data-controller="carousel">

      <% if user_signed_in? && current_user.admin? %>
        <%= link_to edit_about_section_path(@about_section),
            class: "presentation-edit-button" do %>
          ✏️ Modifier la section
        <% end %>
      <% end %>

      <div class="carousel-window">
        <div class="carousel-track" data-carousel-target="track">
          <% if @about_section&.photos&.attached? && @about_section.photos.any? %>
            <% @about_section.photos.each do |photo| %>
              <%= image_tag photo, class: "carousel-image", alt: "Photo de Jennifer" %>
            <% end %>
          <% else %>
            <%= image_tag "diapo 1.jpg", class: "carousel-image", alt: "Image 1" %>
            <%= image_tag "diapo 2.jpg", class: "carousel-image", alt: "Image 2" %>
            <%= image_tag "diapo 3.jpg", class: "carousel-image", alt: "Image 3" %>
            <%= image_tag "diapo 4.jpg", class: "carousel-image", alt: "Image 4" %>
            <%= image_tag "diapo 5.jpg", class: "carousel-image", alt: "Image 5" %>
          <% end %>
        </div>
      </div>

      <div class="carousel-controls">
        <button type="button"
                class="carousel-arrow"
                data-action="click->carousel#previous">
          ←
        </button>
        <button type="button"
                class="carousel-arrow"
                data-action="click->carousel#next">
          →
        </button>
      </div>
    </div>

    <!-- Colonne droite : Texte -->
<div class="about-text">
  <h3><%= @about_section.title.presence || "RANDONNÉE & YOGA POUR SE RECONNECTER À L’ESSENTIEL" %></h3>

  <% if @about_section.body.present? %>
    <%= simple_format(@about_section.body, {}, wrapper_tag: "p") %>
  <% else %>
    <!-- Texte de fallback si aucun texte n'a encore été sauvegardé -->
    <p>Je vous invite à venir vous déposer sur un tapis de yoga...</p>
    <p>Le yoga, c’est l’union...</p>
    <p>Le Vinyasa est une pratique...</p>
    <p>Professeure de yoga Vinyasa...</p>
    <p><strong>Les mercredis...</strong></p>
  <% end %>
</div>



  </div>
</div>



<div class="presentation-section">
  <div class="presentation-container">

    <% if user_signed_in? && current_user.admin? && @presentation.present? && @presentation.persisted? %>
      <%= link_to edit_presentation_path(@presentation),
          class: "presentation-edit-button" do %>
        ✏️ Modifier la section
      <% end %>
    <% end %>

    <div class="presentation-text">
      <span class="presentation-badge">Présentation</span>

      <%# Sécurisé, permet les retours à la ligne et le HTML proprement %>
      <%= simple_format(@presentation.content.presence || "Aucun texte disponible pour le moment.") %>
    </div>

    <div class="presentation-photo">
      <% if @presentation.photo.attached? %>
        <%= image_tag @presentation.photo, class: "presentation-image" %>
      <% else %>
        <%= image_tag "meditation.jpg", class: "presentation-image" %>
      <% end %>
    </div>

  </div>
</div>


<!-- 🔸 FIN SECTION PRÉSENTATION 🔸 -->


<div class="practice-section">
  <div class="practice-container">

    <h2 class="practice-title">Pratiquons ensemble</h2>
    <p class="practice-subtitle">
      Deux expériences complémentaires pour prendre soin de vous&nbsp;:&nbsp;
      <span class="practice-highlight">sur le tapis</span> et
      <span class="practice-highlight">en pleine nature</span>.
    </p>

    <div class="practice-cards">

      <!-- CARTE YOGA -->
      <article class="practice-card">
        <div class="practice-card-header">
          <div class="practice-avatar-wrapper yoga">
            <%= image_tag "yoga.jpg", class: "practice-avatar-large", alt: "Cours de yoga" %>
          </div>
          <span class="practice-chip yoga-chip">🧘‍♀️ Studio & Plein air</span>
        </div>

        <div class="practice-card-body">
          <h3 class="practice-card-title">Yoga</h3>
          <p class="practice-card-description">
            Détendez votre esprit, renforcez votre corps et retrouvez de
            la fluidité dans le mouvement grâce au Vinyasa accessible à
            tous les niveaux.
          </p>
          <a href="<%= courses_path %>" class="practice-card-button">
            Voir les cours de yoga →
          </a>
        </div>
      </article>

      <!-- CARTE RANDONNÉE YOGA -->
      <article class="practice-card">
        <div class="practice-card-header">
          <div class="practice-avatar-wrapper rando">
            <%= image_tag "rando_nature.jpg", class: "practice-avatar-large", alt: "Randonnée yoga" %>
          </div>
          <span class="practice-chip rando-chip">⛰️ Nature & Marche</span>
        </div>

        <div class="practice-card-body">
          <h3 class="practice-card-title">Randonnée Yoga</h3>
          <p class="practice-card-description">
            Marchez, respirez, pratiquez. Des sorties qui mêlent
            randonnée, yoga et reconnexion à soi au cœur de la nature de l’Ubaye.
          </p>
          <a href="<%= hikes_path %>" class="practice-card-button">
            Voir les randonnées →
          </a>
        </div>
      </article>

    </div>
  </div>
</div>







<div class="events-section" id="evenements">
  <h2 class="event-title1">Prochains Événements Yoga &amp; Rando Yoga</h2>

  <div class="events-container">
    <% weekdays = {
      1 => "Lundi",
      2 => "Mardi",
      3 => "Mercredi",
      4 => "Jeudi",
      5 => "Vendredi",
      6 => "Samedi",
      7 => "Dimanche"
    } %>

    <%# === 1. Cours de yoga RÉGULIERS (hebdomadaires) === %>
    <% if @recurring_courses.present? %>
      <% @recurring_courses.each do |course| %>
        <div class="event-row">
          <!-- Image -->
          <div class="event-image">
            <% if course.photo&.attached? %>
              <%= image_tag course.photo, class: "event-photo" %>
            <% else %>
              <%= image_tag "default_course.jpg", class: "event-photo" %>
            <% end %>
          </div>

          <div class="event-details">
            <h3 class="event-title"><%= course.title %></h3>

            <p class="event-info">
              <strong>Type :</strong>&nbsp;Cours de yoga régulier
            </p>

            <% schedules = course.course_schedules
                               .reject { |cs| cs.weekday.blank? || cs.time.blank? }
                               .sort_by { |cs| [cs.weekday, cs.time] } %>

            <% if schedules.any? %>
              <% formatted_slots = schedules.map { |cs|
                   "#{weekdays[cs.weekday]} à #{cs.time.strftime('%Hh%M')}"
                 }.join(" • ")
              %>
              <p class="event-info">
                <strong>Horaires hebdomadaires :</strong>&nbsp;
                <%= formatted_slots %>
              </p>
            <% end %>

            <% if course.price.present? %>
              <p class="event-info">
                <strong>Tarif :</strong>&nbsp;
                <%= number_with_precision(course.price, precision: 2, separator: ",", delimiter: " ") %> €
              </p>
            <% end %>

            <a href="<%= course_path(course) %>" class="event-button">Plus d'informations →</a>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# === 2. Prochains COURS PONCTUELS (non récurrents) === %>
    <% if @upcoming_courses.present? %>
      <% @upcoming_courses.each do |course| %>
        <div class="event-row">
          <!-- Image -->
          <div class="event-image">
            <% if course.photo&.attached? %>
              <%= image_tag course.photo, class: "event-photo" %>
            <% else %>
              <%= image_tag "default_course.jpg", class: "event-photo" %>
            <% end %>
          </div>

          <div class="event-details">
            <h3 class="event-title"><%= course.title %></h3>

            <% if course.start_time.present? %>
              <span class="event-info">
                <strong>Date :</strong>&nbsp;
                <%= l(course.start_time.to_date, format: "%A %d %B %Y") %>
                à <%= course.start_time.strftime("%Hh%M") %>
              </span>
            <% end %>

            <% if course.price.present? %>
              <span class="event-info">
                <strong>Tarif :</strong>&nbsp;
                <%= number_with_precision(course.price, precision: 2, separator: ",", delimiter: " ") %> €
              </span>
            <% end %>

            <a href="<%= course_path(course) %>" class="event-button">Plus d'informations →</a>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="no-event">Aucun cours de yoga ponctuel prévu prochainement.</p>
    <% end %>

    <%# === 3. Prochaine RANDONNÉE YOGA === %>
    <% if @next_hike %>
      <div class="event-row">
        <!-- Image de la rando -->
        <div class="event-image">
          <% if @next_hike.photo&.attached? %>
            <%= image_tag @next_hike.photo, class: "event-photo" %>
          <% else %>
            <%= image_tag "default_hike.jpg", class: "event-photo" %>
          <% end %>
        </div>

        <div class="event-details">
          <h3 class="event-title"><%= @next_hike.title %></h3>

          <% if @next_hike.date.present? && @next_hike.time.present? %>
            <% datetime = DateTime.new(
                  @next_hike.date.year,
                  @next_hike.date.month,
                  @next_hike.date.day,
                  @next_hike.time.hour,
                  @next_hike.time.min
                ) %>
            <span class="event-info">
              <strong>Départ :</strong>&nbsp;<%= l(datetime, format: :long) %>
            </span>
          <% elsif @next_hike.date.present? %>
            <span class="event-info">
              <strong>Départ :</strong>&nbsp;<%= l(@next_hike.date, format: "%A %d %B %Y") %>
            </span>
          <% end %>

          <% if @next_hike.price.present? %>
            <span class="event-info">
              <strong>Tarif :</strong>&nbsp;<%= @next_hike.price %> €
            </span>
          <% end %>

          <a href="<%= hike_path(@next_hike) %>" class="event-button">Plus d'informations →</a>
        </div>
      </div>
    <% else %>
      <p class="no-event">Aucune randonnée prévue prochainement.</p>
    <% end %>
  </div>

  <!-- Liens vers toutes les sessions -->
  <div class="event-links">
    <a href="<%= courses_path %>" class="events-link">Voir tous les cours de yoga</a>
    <a href="<%= hikes_path %>" class="events-link">Voir toutes les randonnées</a>
  </div>
</div>




