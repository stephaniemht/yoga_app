<div class="presentation-edit-wrapper">
  <h1>Modifier la section "À propos"</h1>

  <%= form_with model: @about_section, local: true do |f| %>

    <!-- Texte (si un jour tu ajoutes un champ body / description) -->
    <% if @about_section.respond_to?(:body) %>
      <div class="form-group">
        <%= f.label :body, "Texte (optionnel)" %>
        <%= f.text_area :body,
              rows: 8,
              class: "presentation-edit-textarea" %>
      </div>
    <% end %>

    <!-- Upload des photos du carrousel -->
    <div class="form-group">
      <%= f.label :photos, "Photos du carrousel" %>
      <p class="presentation-edit-help">
        Tu peux sélectionner plusieurs images à la fois.
      </p>
      <%= f.file_field :photos,
            multiple: true,
            class: "presentation-edit-input file" %>

      <% if @about_section.photos.attached? %>
        <div class="carousel-edit-preview">
          <% @about_section.photos.each do |image| %>
            <%= image_tag image, class: "presentation-photo-thumb" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= f.submit "Enregistrer", class: "btn-submit" %>
  <% end %>
</div>
