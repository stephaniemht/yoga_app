<% content_for :title, "Randonnée yoga en Ubaye et Barcelonnette | Jennifer Camp" %>
<% content_for :meta_description,
  "Randonnées yoga, treks et séjours bien-être dans la vallée de l’Ubaye avec Jennifer Camp, accompagnatrice en montagne : Barcelonnette, Pra Loup et alentours." %>

<p class="sr-only">
  Randonnée yoga, séjour bien-être et yoga en montagne dans la vallée de l’Ubaye (Barcelonnette, Pra Loup).
</p>




<div class="hike-index">
  <!-- Image de bannière -->
  <div class="hike-banner">
    <%= image_tag "paysage_4.jpg", class: "hike-banner-image", alt: "Randonnée yoga près de Barcelonnette dans la vallée de l’Ubaye" %>
  </div>

  <div class="hike-content">
    <h1 class="hike-title">Randonnées yoga en Ubaye</h1>

    <div class="hike-list">
      <% @hikes.each do |hike| %>
        <div class="hike-card">
          <!-- Image à gauche -->
          <div class="hike-image">
            <% if hike.photo.attached? %>
              <%= image_tag hike.photo, class: "hike-photo" %>
            <% else %>
              <%= image_tag "default_hike.jpg", class: "hike-photo" %>
            <% end %>
          </div>

          <!-- Contenu principal (texte + bouton) -->
          <div class="hike-main-content">
            <!-- Infos à droite -->
            <div class="hike-info">
              <h2 class="hike-card-title"><%= hike.title %></h2>
              <p><strong>Lieu :</strong> <%= hike.location %></p>

              <% if hike.date.present? && hike.time.present? %>
                <% datetime = DateTime.new(hike.date.year, hike.date.month, hike.date.day, hike.time.hour, hike.time.min) %>
                <p><strong>Départ :</strong> <%= l(datetime, format: :long) %></p>
              <% else %>
                <p><strong>Départ :</strong> <%= l(hike.date, format: "%A %d %B %Y") %></p>
              <% end %>

              <% if hike.end_date.present? %>
                <p><strong>Retour :</strong> <%= l(hike.end_date, format: "%A %d %B %Y") %></p>
              <% end %>

              <p><strong>Tarif :</strong> <%= hike.price %> €</p>
            </div>

            <!-- Bouton à droite -->
            <div class="hike-button-container">
              <a href="<%= hike_path(hike) %>" class="btn btn-primary">Voir la randonnée</a>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <section class="local-seo-content">
      <h2>Randonnée à Barcelonnette et séjours rando yoga en Ubaye</h2>
      <p>
        Partez avec Jennifer Camp, accompagnatrice en montagne et professeure de yoga,
        pour une randonnée autour de Barcelonnette, Pra Loup et dans la vallée de l’Ubaye.
        Les sorties associent marche, nature, respiration et pratique du yoga.
      </p>
      <p>
        Découvrez les prochaines randonnées yoga, journées en montagne, treks et séjours
        bien-être, avec les dates, lieux et tarifs de chaque expérience.
      </p>
    </section>

    <a href="<%= root_path %>" class="btn btn-secondary" data-turbo="false">← Retour à l'accueil</a>
  </div>
</div>
