<div class="presentation-edit-section">
  <div class="presentation-edit-card">

    <h1 class="presentation-edit-title">Modifier la présentation</h1>

    <%= form_with model: @presentation, local: true do |f| %>

      <!-- Champ texte -->
      <div class="presentation-edit-group">
        <%= f.label :content, "Texte", class: "presentation-edit-label" %>
        <%= f.text_area :content, rows: 12, class: "presentation-edit-input textarea" %>
      </div>

      <!-- Upload photo -->
      <div class="presentation-edit-group">
        <%= f.label :photo, "Photo", class: "presentation-edit-label" %>
        <%= f.file_field :photo, class: "presentation-edit-input file" %>

        <% if @presentation.photo.attached? %>
          <div class="presentation-photo-preview">
            <%= image_tag @presentation.photo, class: "presentation-photo-thumb" %>
          </div>
        <% end %>
      </div>

      <%= f.submit "Enregistrer", class: "presentation-edit-submit" %>

    <% end %>

  </div>
</div>
