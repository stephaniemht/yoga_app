<div class="new-course-wrapper">
  <h1>Modifier un Cours de Yoga</h1>

  <%= form_with model: @course, local: true do |f| %>
    <% if @course.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@course.errors.count, "erreur") %> empêchent la mise à jour du cours :</h4>
        <ul>
          <% @course.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Badge si cours suspendu -->
    <% if @course.suspended? %>
      <div class="alert alert-warning" style="margin-bottom: 20px;">
        ⚠️ Ce cours est actuellement <strong>suspendu</strong>.<br>
        Il n'est pas visible par les visiteurs du site.
      </div>
    <% end %>

    <!-- 🧱 Informations générales -->
    <div class="form-group">
      <%= f.label :title, "Nom du cours" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :location, "Adresse" %>
      <%= f.text_field :location, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "Description" %>
      <%= f.text_area :description, class: "form-control" %>
    </div>

    <!-- 🔁 RÉCURRENCE + PONCTUEL (Stimulus) -->
    <div data-controller="course-recurring">
      <!-- Cours régulier ? -->
      <div class="form-group">
        <%= f.label :recurring, "Ce cours est-il régulier ?" %><br>
        <label>
          <%= f.check_box :recurring,
                data: {
                  "course-recurring-target": "checkbox",
                  action: "change->course-recurring#toggle"
                } %>
          <span>Oui, c'est un cours régulier</span>
        </label>
      </div>

      <!-- Bloc pour les cours RÉGULIERS -->
      <div class="recurring-block <%= 'is-hidden' unless @course.recurring? %>"
           data-course-recurring-target="block">
        <h3 style="font-size: 1rem; margin-bottom: 8px;">Récurrence du cours</h3>
        <p style="font-size: 0.9rem; margin-bottom: 10px;">
          Tu peux définir plusieurs créneaux hebdomadaires (ex : Lundi 8h, Jeudi 18h, Samedi 10h).<br>
          Pour supprimer un créneau, laisse le jour et l'heure vides.
        </p>

        <%= f.fields_for :course_schedules do |cs_form| %>
          <div class="form-group course-schedule-fields" style="margin-bottom: 10px;">
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <div style="flex: 1 1 180px;">
                <%= cs_form.label :weekday, "Jour" %>
                <%= cs_form.select :weekday,
                      [
                        ["Lundi", 1],
                        ["Mardi", 2],
                        ["Mercredi", 3],
                        ["Jeudi", 4],
                        ["Vendredi", 5],
                        ["Samedi", 6],
                        ["Dimanche", 7]
                      ],
                      { include_blank: "Choisir un jour" },
                      class: "form-control" %>
              </div>

              <div style="flex: 1 1 160px;">
                <%= cs_form.label :time, "Heure" %>
                <%= cs_form.time_field :time, class: "form-control" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Suspendre un cours (réservé à l'admin, uniquement dans edit) -->
        <div class="form-group" style="margin-top: 10px;">
          <%= f.label :suspended, "Suspendre temporairement ce cours ?" %><br>
          <label>
            <%= f.check_box :suspended %>
            <span>Oui, ce cours est temporairement suspendu</span>
          </label>
        </div>
      </div>

      <!-- Bloc pour les cours PONCTUELS -->
      <div class="form-group" style="margin-top: 20px;">
        <%= f.label :start_time, "Date et heure du cours (si cours ponctuel)" %>
        <%= f.text_field :start_time,
              class: "form-control",
              value: (@course.start_time ? @course.start_time.strftime("%Y-%m-%d %H:%M") : ""),
              data: {
                controller: "flatpickr",
                flatpickr_enable_time_value: true
              } %>
        <small class="text-muted d-block" style="margin-top: 4px;">
          Tu peux laisser ce champ vide si c’est uniquement un cours régulier.
        </small>
      </div>
    </div>

    <!-- Durée -->
    <div class="form-group">
      <%= f.label :duration, "Durée du cours" %>
      <%= f.text_field :duration, class: "form-control" %>
    </div>

    <!-- Tarif -->
    <div class="form-group">
      <%= f.label :price, "Tarif" %>
      <%= f.number_field :price, class: "form-control", step: 0.01 %>
    </div>

    <!-- Photo -->
    <div class="form-group">
      <%= f.label :photo, "Photo (optionnelle)" %>
      <%= f.file_field :photo, class: "form-control" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Mettre à jour le cours", class: "btn-submit" %>
    </div>
  <% end %>
</div>
