<div class="course-show">
  <!-- Bannière pleine largeur -->
  <div class="course-banner" style="position: relative;">

    <% if @course.suspended? && user_signed_in? && current_user.admin? %>
      <div class="suspended-ribbon">
        Suspendu
      </div>
    <% end %>

    <% if @course.photo&.attached? %>
      <%= image_tag @course.photo, class: "course-banner-image", alt: @course.title %>
    <% else %>
      <%= image_tag "Jenny.jpg", class: "course-banner-image", alt: @course.title %>
    <% end %>
  </div>

  <!-- Contenu principal sous la bannière -->
  <div class="course-content">
    <div class="course-info-container">

      <!-- Titre du cours -->
      <h1 class="course-title">
        <%= @course.title %>

        <%# Badge "Suspendu" visible uniquement pour l'admin %>
        <% if user_signed_in? && current_user.admin? && @course.suspended? %>
          <span class="course-badge-suspended">
            Suspendu (non visible pour les visiteurs)
          </span>
        <% end %>
      </h1>

      <!-- Bloc détails -->
      <div class="course-details">
        <% if @course.description.present? %>
          <div class="course-description">
            <strong>Description :</strong>
            <%= simple_format(@course.description) %>
          </div>
          <hr>
        <% end %>


        <% if @course.location.present? %>
          <p><strong>Lieu :</strong> <%= @course.location %></p>
        <% end %>

        <%# --- Affichage du planning si cours récurrent (= via course_schedules) --- %>
        <% if @course.recurring? %>
          <% days = {
            1 => "Lundi",
            2 => "Mardi",
            3 => "Mercredi",
            4 => "Jeudi",
            5 => "Vendredi",
            6 => "Samedi",
            7 => "Dimanche"
          } %>

          <% schedules = @course.course_schedules
                               .where.not(weekday: nil, time: nil)
                               .order(:weekday, :time) %>

          <% if schedules.any? %>
            <p><strong>Cours régulier :</strong></p>
            <ul class="course-recurring-list">
              <% schedules.each do |cs| %>
                <li>
                  <%= "#{days[cs.weekday]} à #{cs.time.strftime('%Hh%M')}" %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>

        <%# --- Date ponctuelle / prochaine séance si renseignée --- %>
        <% if @course.start_time.present? %>
          <p><strong>Date :</strong> <%= l(@course.start_time.to_date, format: "%A %d %B %Y") %></p>
          <p><strong>Heure :</strong> <%= @course.start_time.strftime("%Hh%M") %></p>
        <% end %>

        <% if @course.duration.present? %>
          <p><strong>Durée :</strong> <%= @course.duration %></p>
        <% end %>

        <% if @course.price.present? %>
          <p>
            <strong>Tarif :</strong>
            <%= number_with_precision(@course.price, precision: 2, separator: ",", delimiter: " ") %> €
          </p>
        <% end %>
      </div>

      <!-- Actions admin -->
      <% if user_signed_in? && current_user.admin? %>
        <div class="admin-actions">
          <%= link_to "Modifier", edit_course_path(@course), class: "btn btn-warning" %>
          <%= link_to "Supprimer",
                      course_path(@course),
                      method: :delete,
                      data: { turbo_method: :delete,
                              turbo_confirm: "Es-tu sûr(e) de vouloir supprimer ce cours ?" },
                      class: "btn btn-danger" %>
        </div>
      <% end %>

      <!-- Bouton de retour -->
      <a href="<%= courses_path %>" class="course-back-button">← Retour aux cours</a>
    </div>
  </div>
</div>
