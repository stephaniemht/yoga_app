<div class="course-show">
  <!-- Bannière pleine largeur -->
  <div class="course-banner">
    <% if @course.photo&.attached? %>
      <%= image_tag @course.photo, class: "course-banner-image", alt: @course.title %>
    <% else %>
      <%= image_tag "Jenny.jpg", class: "course-banner-image", alt: @course.title %>
    <% end %>
  </div>

  <!-- Contenu principal sous la bannière -->
  <div class="course-content">
    <div class="course-info-container">

      <!-- Titre du cours -->
      <h1 class="course-title"><%= @course.title %></h1>

      <!-- Bloc détails -->
      <div class="course-details">
        <% if @course.description.present? %>
          <p><strong>Description :</strong> <%= @course.description %></p>
          <hr>
        <% end %>

        <% if @course.location.present? %>
          <p><strong>Lieu :</strong> <%= @course.location %></p>
        <% end %>

        <% if @course.start_time.present? %>
          <p><strong>Date :</strong> <%= l(@course.start_time.to_date, format: "%A %d %B %Y") %></p>
          <p><strong>Heure :</strong> <%= @course.start_time.strftime("%Hh%M") %></p>
        <% end %>

        <% if @course.duration.present? %>
          <p><strong>Durée :</strong> <%= @course.duration %></p>
        <% end %>

        <% if @course.price.present? %>
          <p><strong>Tarif :</strong> <%= @course.price %> €</p>
        <% end %>
      </div>

      <!-- Actions admin -->
      <% if user_signed_in? && current_user.admin? %>
        <div class="admin-actions">
          <%= link_to "Modifier", edit_course_path(@course), class: "btn btn-warning" %>
          <%= link_to "Supprimer",
                      course_path(@course),
                      method: :delete,
                      data: { turbo_method: :delete,
                              turbo_confirm: "Es-tu sûr(e) de vouloir supprimer ce cours ?" },
                      class: "btn btn-danger" %>
        </div>
      <% end %>

      <!-- Bouton de retour -->
      <a href="<%= courses_path %>" class="course-back-button">← Retour aux cours</a>
    </div>
  </div>
</div>
