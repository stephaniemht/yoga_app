<div class="course-index">
  <!-- Image de bannière -->
  <div class="course-banner">
    <%= image_tag "paysage_2.jpg", class: "course-banner-image" %>
  </div>

  <div class="course-content">
    <h1 class="course-title">Prochains Cours de Yoga</h1>

    <div class="course-list">
      <% @courses.each do |course| %>
        <div class="course-card">
          <!-- Image à gauche -->
          <div class="course-image" style="position: relative;">
            <% if course.suspended? && user_signed_in? && current_user.admin? %>
              <div class="suspended-ribbon">
                Suspendu
              </div>
            <% end %>

            <% if course.photo.attached? %>
              <%= image_tag course.photo, class: "course-photo" %>
            <% else %>
              <%= image_tag "default_course.jpg", class: "course-photo" %>
            <% end %>
          </div>

          <!-- Contenu principal (texte + bouton) -->
          <div class="course-main-content">
            <!-- Infos à droite -->
            <div class="course-info">
              <h2 class="course-card-title"><%= course.title %></h2>
              <p><strong>Lieu :</strong> <%= course.location %></p>

              <% if course.recurring? && course.course_schedules.any? %>
                <% days = {
                  1 => "Lundi",
                  2 => "Mardi",
                  3 => "Mercredi",
                  4 => "Jeudi",
                  5 => "Vendredi",
                  6 => "Samedi",
                  7 => "Dimanche"
                } %>
                <p><strong>Créneaux réguliers :</strong></p>
                <ul class="course-recurring-list">
                  <% course.course_schedules.order(:weekday, :time).each do |schedule| %>
                    <% next if schedule.weekday.blank? || schedule.time.blank? %>
                    <li><%= "#{days[schedule.weekday]} à #{schedule.time.strftime('%Hh%M')}" %></li>
                  <% end %>
                </ul>
              <% elsif course.start_time.present? %>
                <p><strong>Date :</strong> <%= l(course.start_time.to_date, format: :long) %></p>
                <p><strong>Heure :</strong> <%= course.start_time.strftime("%Hh%M") %></p>
              <% else %>
                <p><strong>Date :</strong> à venir</p>
              <% end %>

              <% if course.price.present? %>
                <p>
                  <strong>Tarif :</strong>
                  <%= number_with_precision(course.price, precision: 2, separator: ",", delimiter: " ") %> €
                </p>
              <% end %>
            </div>

            <!-- Bouton à droite -->
            <div class="course-button-container">
              <a href="<%= course_path(course) %>" class="btn btn-primary">Voir le cours</a>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <a href="<%= root_path %>" class="btn btn-secondary" data-turbo="false">← Retour à l'accueil</a>
  </div>
</div>
