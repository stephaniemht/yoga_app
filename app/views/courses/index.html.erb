<% content_for :title, "Cours de yoga à Barcelonnette – Yoga Vinyasa & Yin en Ubaye" %>
<% content_for :meta_description,
  "Découvrez les cours de yoga à Barcelonnette : yoga Vinyasa et Yin Yoga, en studio ou en plein air dans la vallée de l’Ubaye et à Pra Loup." %>

<p class="sr-only">
  Cours de yoga à Barcelonnette et dans la vallée de l’Ubaye : Vinyasa, Yin Yoga, bien-être et mobilité.
</p>


<div class="course-index">
  <!-- Image de bannière -->
  <div class="course-banner">
    <%= image_tag "paysage_2.jpg", class: "course-banner-image" %>
  </div>

  <div class="course-content">
    <h1 class="course-title">Prochains Cours de Yoga</h1>

    <div class="course-list">
      <% @courses.each do |course| %>
        <div class="course-card">
          <!-- Image à gauche -->
          <div class="course-image" style="position: relative;">
            <% if course.suspended? && user_signed_in? && current_user.admin? %>
              <div class="suspended-ribbon">
                Suspendu
              </div>
            <% end %>

            <% if course.photo.attached? %>
              <%= image_tag course.photo, class: "course-photo" %>
            <% else %>
              <%= image_tag "default_course.jpg", class: "course-photo" %>
            <% end %>
          </div>

          <!-- Contenu principal (texte + bouton) -->
          <div class="course-main-content">
            <!-- Infos à droite -->
            <div class="course-info">
              <h2 class="course-card-title">
                <%= course.title %>

                <%# Badge "Suspendu" visible seulement pour l'admin %>
                <% if user_signed_in? && current_user.admin? && course.suspended? %>
                  <span class="course-badge-suspended-inline">Suspendu</span>
                <% end %>
              </h2>

              <p><strong>Lieu :</strong> <%= course.location %></p>

              <%# --- Si cours récurrent : on affiche les jours/horaires via course_schedules --- %>
              <% if course.recurring? %>
                <% days = {
                  1 => "Lundi",
                  2 => "Mardi",
                  3 => "Mercredi",
                  4 => "Jeudi",
                  5 => "Vendredi",
                  6 => "Samedi",
                  7 => "Dimanche"
                } %>

                <% schedules = course.course_schedules
                                     .where.not(weekday: nil, time: nil)
                                     .order(:weekday, :time) %>

                <% if schedules.any? %>
                  <p><strong>Cours régulier :</strong></p>
                  <ul class="course-recurring-list">
                    <% schedules.each do |cs| %>
                      <li><%= "#{days[cs.weekday]} à #{cs.time.strftime('%Hh%M')}" %></li>
                    <% end %>
                  </ul>
                <% end %>

                <%# Optionnel : si tu as aussi une prochaine date ponctuelle renseignée %>
                <% if course.start_time.present? %>
                  <p>
                    <strong>Prochaine date ponctuelle :</strong>
                    <%= l(course.start_time.to_date, format: :long) %> à
                    <%= course.start_time.strftime("%Hh%M") %>
                  </p>
                <% end %>

              <% else %>
                <%# --- Cours non récurrent : comme avant --- %>
                <% if course.start_time.present? %>
                  <p><strong>Date :</strong> <%= l(course.start_time.to_date, format: :long) %></p>
                  <p><strong>Heure :</strong> <%= course.start_time.strftime("%Hh%M") %></p>
                <% else %>
                  <p><strong>Date :</strong> à venir</p>
                <% end %>
              <% end %>

              <% if course.price.present? %>
                <p>
                  <strong>Tarif :</strong>
                  <%= number_with_precision(course.price, precision: 2, separator: ",", delimiter: " ") %> €
                </p>
              <% end %>
            </div>

            <!-- Bouton à droite -->
            <div class="course-button-container">
              <a href="<%= course_path(course) %>" class="btn btn-primary">Voir le cours</a>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <a href="<%= root_path %>" class="btn btn-secondary" data-turbo="false">← Retour à l'accueil</a>
  </div>
</div>
