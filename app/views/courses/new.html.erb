<div class="new-course-wrapper">
  <h1>Créer un Cours de Yoga</h1>

  <%= form_with model: @course, local: true do |f| %>
    <% if @course.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@course.errors.count, "erreur") %> empêchent la création du cours :</h4>
        <ul>
          <% @course.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- 🧱 Informations générales -->
    <div class="form-group">
      <%= f.label :title, "Nom du cours" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :location, "Adresse" %>
      <%= f.text_field :location, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "Description" %>
      <%= f.text_area :description, class: "form-control" %>
    </div>

    <!-- 🔁 RÉCURRENCE (pilotée par Stimulus) -->
    <div data-controller="course-recurring">
      <hr>
      <div class="form-group">
        <%= f.label :recurring, "Ce cours est-il récurrent ?" %><br>
        <label>
          <%= f.check_box :recurring,
                data: {
                  "course-recurring-target": "checkbox",
                  action: "change->course-recurring#toggle"
                } %>
          <span>Oui, ce cours a lieu toutes les semaines</span>
        </label>
        <small class="text-muted d-block" style="margin-top: 4px;">
          Par exemple : tous les lundis à 8h et les jeudis à 18h.
        </small>
      </div>

      <!-- Bloc pour les cours RÉGULIERS -->
      <div class="recurring-block is-hidden" data-course-recurring-target="block">
        <h3 style="font-size: 1rem; margin-bottom: 8px;">Récurrence du cours</h3>

        <!-- Premier créneau -->
        <div class="form-group">
          <h4 style="font-size: 0.95rem; margin-bottom: 6px;">Premier créneau</h4>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <div style="flex: 1 1 180px;">
              <%= f.label :day_1, "Jour" %>
              <%= f.select :day_1,
                    [
                      ["Lundi", 1],
                      ["Mardi", 2],
                      ["Mercredi", 3],
                      ["Jeudi", 4],
                      ["Vendredi", 5],
                      ["Samedi", 6],
                      ["Dimanche", 7]
                    ],
                    { include_blank: "Choisir un jour" },
                    class: "form-control" %>
            </div>

            <div style="flex: 1 1 160px;">
              <%= f.label :time_1, "Heure" %>
              <%= f.time_field :time_1, class: "form-control" %>
            </div>
          </div>
        </div>

        <!-- Deuxième créneau optionnel -->
        <div class="form-group">
          <h4 style="font-size: 0.95rem; margin-bottom: 6px;">Deuxième créneau (optionnel)</h4>
          <small class="text-muted d-block" style="margin-bottom: 6px;">
            À remplir uniquement si le même cours a un deuxième jour/heure (ex. jeudi 18h).
          </small>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <div style="flex: 1 1 180px;">
              <%= f.label :day_2, "Jour" %>
              <%= f.select :day_2,
                    [
                      ["Lundi", 1],
                      ["Mardi", 2],
                      ["Mercredi", 3],
                      ["Jeudi", 4],
                      ["Vendredi", 5],
                      ["Samedi", 6],
                      ["Dimanche", 7]
                    ],
                    { include_blank: "Aucun deuxième jour" },
                    class: "form-control" %>
            </div>

            <div style="flex: 1 1 160px;">
              <%= f.label :time_2, "Heure" %>
              <%= f.time_field :time_2, class: "form-control" %>
            </div>
          </div>
        </div>
      </div>

      <!-- 📅 Cours ponctuel (optionnel) -->
      <hr>
      <div class="form-group">
        <%= f.label :start_time, "Date et Heure d'une prochaine séance (optionnel)" %>
        <%= f.text_field :start_time,
              class: "form-control",
              data: {
                controller: "flatpickr",
                flatpickr_enable_time_value: true
              } %>
        <small class="text-muted d-block" style="margin-top: 4px;">
          Utilise ce champ pour un cours ponctuel (atelier, événement) ou pour planifier la prochaine date précise.
        </small>
      </div>
    </div>

    <!-- ⏱ Durée / tarif / photo -->
    <div class="form-group">
      <%= f.label :duration, "Durée du cours" %>
      <%= f.text_field :duration, class: "form-control", placeholder: "Ex. 1h, 1h15…" %>
    </div>

    <div class="form-group">
      <%= f.label :price, "Tarif" %>
      <%= f.number_field :price, class: "form-control", step: "0.01" %>
    </div>

    <div class="form-group">
      <%= f.label :photo, "Photo (optionnelle)" %>
      <%= f.file_field :photo, class: "form-control" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Créer le cours", class: "btn-submit" %>
    </div>
  <% end %>
</div>
